    <!-- First-start screen -->
    <string name="setup_title">Welcome to BoardMe</string>
    <string name="setup_intro">Connect to your own Kanboard server. Both http:// and https:// addresses work, including servers with a self-signed certificate.</string>
    <string name="setup_local_intro">No server? BoardMe also works on this phone only, with nothing sent anywhere.</string>
    <string name="setup_http_notice">This address is not encrypted. Anyone on the network could read your token and tasks.</string>
    <string name="field_address">Server address</string>
    <string name="field_address_hint">https://kanboard.example.com</string>
    <string name="field_username">Username</string>
    <string name="field_token">Personal access token</string>

    <!-- Plain HTTP warning -->
    <string name="http_title">Connection is not encrypted</string>
    <string name="http_message">You are about to connect with plain http://. Your username, token and all task data travel unprotected. This is acceptable on a trusted home network, but not over the internet or public Wi-Fi.</string>
    <string name="http_continue">Connect anyway</string>

    <!-- Self-signed certificate dialog -->
    <string name="cert_title">Trust this certificate?</string>
    <string name="cert_intro">The server uses a certificate that Android does not recognise. If you trust it, BoardMe will only ever connect to a server presenting exactly this certificate.</string>
    <string name="cert_self_signed">This certificate is self-signed.</string>
    <string name="cert_subject">Issued to: %s</string>
    <string name="cert_issuer">Issued by: %s</string>
    <string name="cert_valid">Valid from %1$s to %2$s</string>
    <string name="cert_fingerprint">SHA-256 fingerprint</string>
    <string name="cert_advice">Compare this fingerprint with the one shown by your server (for example with: openssl x509 -noout -fingerprint -sha256). Only continue if they match.</string>
    <string name="cert_trust">Trust this certificate</string>

